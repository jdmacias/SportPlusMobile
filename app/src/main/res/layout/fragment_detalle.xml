<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <ImageView
                android:id="@+id/ivDetalle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/image_detail_height"
                android:background="@drawable/bg_image_box"
                android:contentDescription="@string/cd_img_zapatillas"
                android:padding="@dimen/space_l"
                android:scaleType="fitCenter"
                android:src="@drawable/img_producto_zapatillas" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/detalle_etiqueta"
                android:textAppearance="@style/TextAppearance.SportPlus.Overline" />

            <TextView
                android:id="@+id/tvDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.SportPlus.ProductNameLarge"
                tools:text="@string/producto_zapatillas_nombre" />

            <TextView
                android:id="@+id/tvDetallePrecio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.SportPlus.PriceLarge"
                tools:text="$389.900" />

            <TextView
                android:id="@+id/tvDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.SportPlus.Body"
                tools:text="@string/producto_zapatillas_descripcion" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/cantidad"
                android:textAppearance="@style/TextAppearance.SportPlus.Label" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetalleMenos"
                    style="@style/Widget.SportPlus.Button.Quantity"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/cd_menos"
                    android:text="@string/simbolo_menos" />

                <TextView
                    android:id="@+id/tvDetalleCantidad"
                    android:layout_width="68dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:background="@drawable/bg_quantity"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SportPlus.QuantityValue"
                    tools:text="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetalleMas"
                    style="@style/Widget.SportPlus.Button.Quantity"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/cd_mas"
                    android:text="@string/simbolo_mas" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetalleAgregar"
            style="@style/Widget.SportPlus.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boton_agregar_carrito" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetalleVolver"
            style="@style/Widget.SportPlus.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volver_catalogo" />
    </LinearLayout>
</LinearLayout>
