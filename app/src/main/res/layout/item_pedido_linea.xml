<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xs"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvLineaDescripcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.SportPlus.Support"
        tools:text="1 × Zapatillas EvoRun Pro" />

    <TextView
        android:id="@+id/tvLineaValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SportPlus.SupportValue"
        tools:text="$389.900" />
</LinearLayout>
